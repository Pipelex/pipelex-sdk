{
  "ecosystem": "js",
  "default": "webapp-js",
  "templates": {
    "webapp-js": {
      "extras": ["METHOD_NAME", "LABEL"]
    }
  },
  "create": {
    "required": "METHOD",
    "shared": [
      "METHOD",
      "NAME",
      "TITLE",
      "DESCRIPTION",
      "PIPE",
      "AUTHOR_NAME",
      "AUTHOR_EMAIL",
      "REPO_URL",
      "LICENSE",
      "LICENSE_HOLDER",
      "LICENSE_YEAR",
      "DRY_RUN"
    ],
    "switches": ["DRY_RUN"]
  },
  "otherEcosystems": {
    "python": {
      "copyOut": "https://github.com/Pipelex/pipelex-sdk/tree/main/method-apps/{template}#start-a-project-from-the-template"
    }
  }
}
