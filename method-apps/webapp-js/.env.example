# Pipelex API endpoint and credentials.
# Get an API key at https://app.pipelex.com.
PIPELEX_BASE_URL=https://api.pipelex.com
PIPELEX_API_KEY=

# The execution mode every method runs in, chosen by the deployment: "durable"
# (start + poll, survives the hosted ~30s cap, streams live status) or
# "blocking" (one synchronous execute, for an API that does not serve durable
# runs). The page offers no switch. Defaults to "durable" when unset; read at
# build time, so a change needs a rebuild or a dev-server restart.
NEXT_PUBLIC_EXECUTION_MODE=durable
