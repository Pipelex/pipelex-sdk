{
  "name": "pipelex-method-webapp-js",
  "version": "0.5.7",
  "private": true,
  "description": "A Next.js app that runs MTHDS methods through the Pipelex API, with each method's input form and result view generated from its own contract.",
  "scripts": {
    "dev": "next dev -H ${APP_HOST:-127.0.0.1} -p ${APP_PORT:-4300}",
    "build": "next build",
    "start": "next start -H ${APP_HOST:-127.0.0.1} -p ${APP_PORT:-4300}",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern \"**/*.{ts,tsx,mts,mjs,js,css,json,md}\" \".claude/skills/bootstrap/scripts/*.mjs\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"**/*.{ts,tsx,mts,mjs,js,css,json,md}\" \".claude/skills/bootstrap/scripts/*.mjs\"",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "codegen": "node --experimental-strip-types scripts/codegen.mts",
    "codegen:check": "node --experimental-strip-types scripts/codegen-check.mts",
    "codegen:verify": "node --experimental-strip-types scripts/codegen-verify.mts",
    "add-method": "node --experimental-strip-types scripts/add-method.mts",
    "create": "node --experimental-strip-types scripts/create.mts",
    "serve": "node --experimental-strip-types scripts/serve.mts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@pipelex/mthds-form": "^0.10.0",
    "@pipelex/sdk": "^0.26.0",
    "next": "^16.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.8",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.4.5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ],
    "*.mjs": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
