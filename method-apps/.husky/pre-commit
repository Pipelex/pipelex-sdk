# The family's pre-commit hook. Each template carries its own hook, which
# travels into the projects created from it; this one runs each of them from
# inside its template's directory, for the templates the commit touches.
root=$(git rev-parse --show-toplevel)
for hook in "$root"/*/.husky/pre-commit; do
  [ -f "$hook" ] || continue
  dir=$(dirname "$(dirname "$hook")")
  git diff --cached --quiet -- "$dir" && continue
  echo "pre-commit: $(basename "$dir")"
  (cd "$dir" && PATH="$dir/node_modules/.bin:$PATH" sh -e "$hook") || exit 1
done
