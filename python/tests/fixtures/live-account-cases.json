{
  "about": "The account check every live suite of this repository runs before its first case, which both SDKs' suites implement and must agree on (docs/live-accounts.md at the repository's root). Each case names a target from 'targets', the variable naming its base URL, the URL used when that variable is unset or empty, null for none, and the command a refusal tells the person to run; 'env' the environment the check reads; and 'me' the answer of GET /v1/me, a 'status' and a JSON 'body', or null when the check must not send it. 'verdict' is what the check decides: 'no_target' when there is no base URL, so the live legs skip; 'local' when the base URL is a loopback address, which holds no registered test account; 'confirmed' when the account is the one the expectations name; and 'refused' otherwise. Every string of 'mentions' appears in the verdict's line or message, and no string of 'absent' does. The expectations sit beside the key, as the workspace's test-account run sets them: PIPELEX_API_KEY_EXPECTED_ORG_ID, PIPELEX_API_KEY_EXPECTED_ROLE and PIPELEX_API_KEY_EXPECTED_EMAIL. Values are rendered as JSON, so a string reads in double quotes and a missing value as null.",
  "targets": {
    "js_e2e": {
      "base_url_env": "PIPELEX_E2E_BASE_URL",
      "default_base_url": "http://localhost:8081",
      "run_command": "test-account run pipelex-sdk-js-e2e -- make -C js test-e2e"
    },
    "python_e2e": {
      "base_url_env": "PIPELEX_E2E_BASE_URL",
      "default_base_url": null,
      "run_command": "test-account run pipelex-sdk-python-e2e -- make -C python e2e-test"
    },
    "starters": {
      "base_url_env": "PIPELEX_BASE_URL",
      "default_base_url": "https://api.pipelex.com",
      "run_command": "test-account run pipelex-sdk-starters -- make live-starter IN=<starter>"
    }
  },
  "cases": [
