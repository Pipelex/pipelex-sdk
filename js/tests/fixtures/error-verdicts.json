        { "variant": "a used upload grant", "only_in": "js", "given": { "status": 412, "code": "grant_used" }, "expected": { "error_domain": "input", "retryable": false } },
        { "variant": "an expired upload grant", "only_in": "js", "given": { "status": 403, "code": "grant_expired" }, "expected": { "error_domain": "input", "retryable": false } }
