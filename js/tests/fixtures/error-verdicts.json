{
  "about": "The error verdicts the two Pipelex SDKs must agree on, every expected value an error domain (input, config or runtime) and a retryable boolean. 'fallback' holds the table an ApiResponseError falls back to when the server sent no usable member: the HTTP status, the platform code (or null), and whether the body is named (it carries a platform code or a runner error_type). 'server_sent' holds refused requests whose problem document carries members of its own, each member taken when valid and read from the fallback otherwise, except that a valid input or config domain sent without a boolean retryable is not retryable; a 'body' is sent as JSON when it is an object, as raw text when it is a string, and as an empty body when it is null. 'classes' holds every exported error class, by its class name, with the expected verdict of each variant: 'given' names what the variant is built from (a code, a status, a body, a report, a wrapped cause, or a declared verdict), and in a cause the class name Error means the language's own base error, which carries no verdict. A class or a variant marked 'only_in' exists in that SDK alone, and the other skips it; a class marked 'abstract' is the base of the family and has no variant. Each SDK's suite is to drive its own code through every case and fail on a class it cannot build. This file is meant to exist twice, as js/tests/fixtures/error-verdicts.json and python/tests/fixtures/error-verdicts.json: the Python copy is to be added with the Python suite that drives it and a check at the repository's root, and from then on the two copies must stay byte for byte identical, so change both together.",
  "fallback": [
    { "case": "a bad request", "status": 400, "code": null, "named": false, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "an unauthenticated request", "status": 401, "code": null, "named": false, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a plan that does not cover the request", "status": 402, "code": null, "named": false, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a forbidden request", "status": 403, "code": null, "named": false, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a named 404, by a platform code", "status": 404, "code": "not_found", "named": true, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a named 404, by a runner error_type", "status": 404, "code": null, "named": true, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a run with no results, a named 404", "status": 404, "code": "run_no_results", "named": true, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a bare 404, a route the deployment does not serve", "status": 404, "code": null, "named": false, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a method the route does not serve", "status": 405, "code": null, "named": false, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a request timeout", "status": 408, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a conflict with the stored state", "status": 409, "code": "conflict", "named": true, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a conflict with no code", "status": 409, "code": null, "named": false, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "the organization's API key limit", "status": 409, "code": "pipelex_api_key_limit_reached", "named": true, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a body past the size cap", "status": 413, "code": null, "named": false, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a 4xx the table does not list", "status": 418, "code": null, "named": false, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "an unprocessable request", "status": 422, "code": "validation_failed", "named": true, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a rate limit", "status": 429, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "an internal error", "status": 500, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a storage backend failure", "status": 500, "code": "storage_backend_failed", "named": true, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a feature the deployment does not implement", "status": 501, "code": null, "named": false, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a bad gateway", "status": 502, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a promotional credit still pending", "status": 502, "code": "promo_credit_pending", "named": true, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a service unavailable", "status": 503, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a gateway timeout", "status": 504, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a 5xx the table does not list", "status": 507, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a redirect no route answers with", "status": 302, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": false } },
    { "case": "a success status no refusal carries", "status": 200, "code": null, "named": false, "expected": { "error_domain": "runtime", "retryable": false } }
  ],
  "server_sent": [
    { "case": "both members sent override the fallback of a 5xx", "status": 500, "body": { "error_type": "LLMCompletionError", "error_domain": "config", "retryable": false }, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "both members sent override the fallback of a 4xx", "status": 422, "body": { "error_type": "InferenceCapacityError", "error_domain": "runtime", "retryable": true }, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "an input domain sent without retryable is not retryable", "status": 500, "body": { "error_type": "PipeRunError", "error_domain": "input" }, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a config domain sent without retryable is not retryable", "status": 500, "body": { "error_type": "PipelexConfigError", "error_domain": "config" }, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a runtime domain sent without retryable takes the fallback's retryable", "status": 503, "body": { "error_type": "InferenceProviderError", "error_domain": "runtime" }, "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "a runtime domain sent without retryable on a 4xx takes the fallback's retryable", "status": 422, "body": { "error_type": "InferenceCapacityError", "error_domain": "runtime" }, "expected": { "error_domain": "runtime", "retryable": false } },
    { "case": "a retryable sent beside a config domain wins", "status": 500, "body": { "error_type": "PipelexConfigError", "error_domain": "config", "retryable": true }, "expected": { "error_domain": "config", "retryable": true } },
    { "case": "retryable sent without a domain takes the fallback's domain", "status": 400, "body": { "detail": "Busy, try again.", "retryable": true }, "expected": { "error_domain": "input", "retryable": true } },
    { "case": "a domain outside the three reads as absent", "status": 503, "body": { "error_domain": "network", "retryable": false }, "expected": { "error_domain": "runtime", "retryable": false } },
    { "case": "a retryable that is not a boolean reads as absent", "status": 429, "body": { "error_domain": "input", "retryable": "yes" }, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "an empty domain reads as absent", "status": 401, "body": { "detail": "Invalid API key.", "error_domain": "" }, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "null members read as absent", "status": 403, "body": { "detail": "Forbidden.", "error_domain": null, "retryable": null }, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a 404 named by a legacy detail object", "status": 404, "body": { "detail": { "error_type": "PipeNotFoundError", "message": "No pipe 'summarize'." } }, "expected": { "error_domain": "input", "retryable": false } },
    { "case": "a bare runner's 404", "status": 404, "body": { "detail": "Not Found" }, "expected": { "error_domain": "config", "retryable": false } },
    { "case": "a gateway's HTML page", "status": 502, "body": "<html>Bad Gateway</html>", "expected": { "error_domain": "runtime", "retryable": true } },
    { "case": "an empty body", "status": 504, "body": null, "expected": { "error_domain": "runtime", "retryable": true } }
  ],
  "classes": [
    {
      "class": "PipelexRequestError",
      "abstract": true,
      "variants": []
    },
    {
      "class": "ApiResponseError",
      "variants": [
        { "variant": "a refusal carrying no member", "given": { "status": 402, "body": { "detail": "Insufficient credits." } }, "expected": { "error_domain": "config", "retryable": false } },
        { "variant": "a runner's own verdict", "given": { "status": 500, "body": { "error_type": "LLMCompletionError", "error_domain": "config", "retryable": false } }, "expected": { "error_domain": "config", "retryable": false } }
      ]
    },
    {
      "class": "ApiUnreachableError",
      "variants": [
        { "variant": "a refused connection", "given": { "code": "ECONNREFUSED" }, "expected": { "error_domain": "config", "retryable": true } },
        { "variant": "an unknown host", "given": { "code": "ENOTFOUND" }, "expected": { "error_domain": "config", "retryable": true } },
        { "variant": "no code", "given": { "code": null }, "expected": { "error_domain": "config", "retryable": true } },
        { "variant": "the SDK's own request timeout", "given": { "code": "ABORT_TIMEOUT" }, "expected": { "error_domain": "runtime", "retryable": true } }
      ]
    },
    {
      "class": "PipelineExecuteTimeoutError",
