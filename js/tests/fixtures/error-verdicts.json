        { "variant": "storage throttling the request", "only_in": "js", "given": { "code": "unexpected", "status": 429 }, "expected": { "error_domain": "runtime", "retryable": true } },
        { "variant": "an unmapped status", "only_in": "js", "given": { "code": "unexpected", "status": 418 }, "expected": { "error_domain": "runtime", "retryable": false } }
