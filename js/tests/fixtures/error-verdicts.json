        { "variant": "a report saying not retryable", "given": { "report": { "error_type": "LLMCompletionError", "error_domain": "config", "retryable": false } }, "expected": { "error_domain": "config", "retryable": false } },
        { "variant": "a report saying nothing about retrying", "given": { "report": { "error_type": "PipeInputError", "error_domain": "input" } }, "expected": { "error_domain": "input", "retryable": false } },
        { "variant": "a report saying retryable is unknown", "given": { "report": { "error_domain": "config", "retryable": null } }, "expected": { "error_domain": "config", "retryable": false } },
        { "variant": "a report with a domain outside the three", "given": { "report": { "error_domain": "network", "retryable": true } }, "expected": { "error_domain": "runtime", "retryable": true } },
        { "variant": "an empty report", "given": { "report": {} }, "expected": { "error_domain": "runtime", "retryable": false } },
        { "variant": "no report", "given": { "report": null }, "expected": { "error_domain": "runtime", "retryable": false } }
      ]
    },
    {
      "class": "RunTimeoutError",
      "variants": [
        { "variant": "a wait that ran out", "given": {}, "expected": { "error_domain": "runtime", "retryable": true } }
      ]
    },
