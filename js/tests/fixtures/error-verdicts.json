        { "variant": "a forbidden upload", "given": { "status": 403 }, "expected": { "error_domain": "config", "retryable": false } }
      ]
    },
    {
      "class": "UploadTransportError",
      "variants": [
        { "variant": "a wrapped plan refusal", "given": { "cause": { "class": "ApiResponseError", "status": 402, "body": { "detail": "Insufficient credits." } } }, "expected": { "error_domain": "config", "retryable": false } },
