        { "variant": "a 5xx from storage", "only_in": "js", "given": { "code": "server_error", "status": 503 }, "expected": { "error_domain": "runtime", "retryable": true } },
        { "variant": "a 501 from storage", "only_in": "js", "given": { "code": "server_error", "status": 501 }, "expected": { "error_domain": "runtime", "retryable": false } },
        { "variant": "a server error with no status", "only_in": "js", "given": { "code": "server_error", "status": null }, "expected": { "error_domain": "runtime", "retryable": true } },
